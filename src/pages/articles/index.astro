---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import DatedContentList from "../../components/DatedContentList.astro";

const articles = (await getCollection("articles"))
	.filter((article) => !article.data.draft)
	.sort(
		(left, right) =>
			right.data.published.valueOf() -
			left.data.published.valueOf(),
	);
---

<BaseLayout
	title="Articles"
	description="Long-form articles about software, systems and whatever escaped containment."
>
	<h1>Articles</h1>

	<p class="lead">
		Long-form writing, explanations and structured arguments.
	</p>

	<DatedContentList entries={articles} basePath="/articles" />
</BaseLayout>