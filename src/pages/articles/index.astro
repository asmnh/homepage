---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const articles = (await getCollection("articles"))
	.filter((article) => !article.data.draft)
	.sort(
		(left, right) =>
			right.data.published.valueOf() -
			left.data.published.valueOf(),
	);
---

<BaseLayout
	title="Articles"
	description="Longer technical articles by Asmo."
>
	<h1>Articles</h1>

	<p class="lead">
		Longer pieces that have survived at least one editing pass.
	</p>

	{
		articles.length === 0 ? (
			<p>Nothing published yet.</p>
		) : (
			<ol class="content-list">
				{articles.map((article) => (
					<li>
						<article>
							<h2>
								<a href={`/articles/${article.id}/`}>
									{article.data.title}
								</a>
							</h2>

							<p>{article.data.description}</p>

							<time datetime={article.data.published.toISOString()}>
								{article.data.published.toLocaleDateString("en-GB", {
									year: "numeric",
									month: "long",
									day: "numeric",
									timeZone: "UTC",
								})}
							</time>
						</article>
					</li>
				))}
			</ol>
		)
	}
</BaseLayout>