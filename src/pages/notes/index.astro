---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import DatedContentList from "../../components/DatedContentList.astro";

const notes = (await getCollection("notes"))
	.filter((note) => !note.data.draft)
	.sort(
		(left, right) =>
			right.data.published.valueOf() -
			left.data.published.valueOf(),
	);
---

<BaseLayout
	title="Notes"
	description="Shorter observations, fragments and working ideas."
>
	<h1>Notes</h1>

	<p class="lead">
		Shorter observations that deserve persistence without being inflated into articles.
	</p>

	<DatedContentList entries={notes} basePath="/notes" />
</BaseLayout>