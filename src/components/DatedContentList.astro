---
interface Entry {
    id: string;
    data: {
        title: string;
        description: string;
        published: Date;
        tags: string[];
    };
}

interface Props {
    entries: Entry[];
    basePath: string;
}

const { entries, basePath } = Astro.props;

const formatDate = (date: Date) => date.toISOString().slice(0, 10);
---

<ul class="content-list">
    {
        entries.map((entry) => (
            <li>
                <article>
                    <header>
                        <h2>
                            <a href={`${basePath}/${entry.id}/`}>
                                {entry.data.title}
                            </a>
                        </h2>

                        <time datetime={entry.data.published.toISOString()}>
                            {formatDate(entry.data.published)}
                        </time>
                    </header>

                    <p>{entry.data.description}</p>

                    {entry.data.tags.length > 0 && (
                        <ul class="tag-list" aria-label="Tags">
                            {entry.data.tags.map((tag) => (
                                <li>{tag}</li>
                            ))}
                        </ul>
                    )}
                </article>
            </li>
        ))
    }
</ul>
